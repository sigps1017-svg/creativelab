---
// Vignette de projet : photo en noir et blanc qui reprend ses couleurs au survol,
// avec lieu, nom et année au centre.
import type { Projet } from '../../data/projets';
interface Props {
  projet: Projet;
  classe?: string;
}
const { projet, classe } = Astro.props;
---

<li class:list={['ss-carte', classe]} data-slug={projet.slug} data-apparait>
  <a href={`/projets/${projet.slug}`}>
    <img src={projet.image} alt="" loading="lazy" decoding="async" />
    <span class="ss-carte-texte">
      {projet.lieu && <span class="ss-carte-lieu">{projet.lieu}</span>}
      <span class="ss-carte-titre">{projet.titre}</span>
      {projet.annee && <span class="ss-carte-annee">{projet.annee}</span>}
    </span>
  </a>
</li>
