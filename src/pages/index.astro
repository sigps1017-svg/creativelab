---
import Base from '../layouts/Base.astro';
import Entete from '../components/Entete.astro';
import { projets, projetsGalerie } from '../data/projets';
import { equipe } from '../data/equipe';
import { services } from '../data/services';

// Le parcours : chaque section du site est un espace du bâtiment.
// `etage` sert au plan de navigation ; l'ordre doit suivre celui de src/scripts/experience/parcours.ts.
const espaces = [
  { id: 'accueil', nom: 'Parvis', etage: 'Extérieur' },
  { id: 'manifeste', nom: 'Hall', etage: 'Rez-de-chaussée' },
  { id: 'projets', nom: 'Galerie', etage: 'Rez-de-chaussée' },
  { id: 'atelier', nom: 'Atelier', etage: '1er étage' },
  { id: 'services', nom: 'Services', etage: '1er étage' },
  { id: 'equipe', nom: 'Équipe', etage: '1er étage' },
  { id: 'contact', nom: 'Terrasse', etage: 'Toit' },
];

const galerie = projetsGalerie.map(({ slug, titre, image }) => ({ slug, titre, image }));
const mur = equipe.map(({ nom, role, photo, description, email }) => ({ nom, role, photo, description, email }));
---

<Base
  titre="Creativ Lab Architects : l'architecture se visite"
  description="Entrez dans la maison Creativ Lab Architects et visitez nos projets réalisés : logements, bureaux, équipements."
>
  <canvas id="scene" aria-hidden="true"></canvas>

  <div id="chargement" role="status" aria-live="polite">
    <div class="porte porte-gauche"></div>
    <div class="porte porte-droite"></div>
    <div class="intro-fente" aria-hidden="true"></div>
    <div class="intro-cadre">
      <svg class="intro-plan" viewBox="0 0 1000 620" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <g class="plan-axes">
          <path d="M150 40V580M383 40V580M617 40V580M850 40V580" pathLength="1" />
          <path d="M60 130H940M60 310H940M60 490H940" pathLength="1" />
        </g>
        <g class="plan-reperes">
          <circle cx="150" cy="22" r="14" /><circle cx="383" cy="22" r="14" /><circle cx="617" cy="22" r="14" /><circle cx="850" cy="22" r="14" />
          <circle cx="40" cy="130" r="14" /><circle cx="40" cy="310" r="14" /><circle cx="40" cy="490" r="14" />
          <text x="150" y="27">A</text><text x="383" y="27">B</text><text x="617" y="27">C</text><text x="850" y="27">D</text>
          <text x="40" y="135">1</text><text x="40" y="315">2</text><text x="40" y="495">3</text>
        </g>
        <g class="plan-murs">
          <path d="M150 130H850V490H560M440 490H150Z" pathLength="1" />
          <path d="M383 200H617V420H383Z" pathLength="1" />
          <path d="M440 490A60 60 0 0 1 500 430M560 490A60 60 0 0 0 500 430" pathLength="1" />
          <path d="M680 160h140v120h-140zM700 160v120M720 160v120M740 160v120M760 160v120M780 160v120M800 160v120" pathLength="1" />
          <path d="M180 160h150v90h-150zM180 360h150v100h-150z" pathLength="1" />
        </g>
        <g class="plan-cotes">
          <path d="M150 560H850M150 550v20M850 550v20M383 555v10M617 555v10" pathLength="1" />
          <path d="M900 130V490M890 130h20M890 490h20" pathLength="1" />
          <text x="500" y="552">42,00</text>
          <text x="925" y="314" transform="rotate(90 925 314)">21,60</text>
        </g>
        <g class="plan-nord">
          <circle cx="930" cy="580" r="18" />
          <path d="M930 562l7 26-7-6-7 6z" />
        </g>
      </svg>
      <span class="intro-coin coin-hg"></span><span class="intro-coin coin-hd"></span>
      <span class="intro-coin coin-bg"></span><span class="intro-coin coin-bd"></span>
      <p class="intro-legende legende-hg">Creativ Lab Architects<br /><span>Maison de l'architecture</span></p>
      <p class="intro-legende legende-hd">Plan de rez-de-chaussée<br /><span>Éch. 1:200</span></p>
      <div class="intro-compteur" aria-hidden="true">
        <span class="roue"><span>0<br />1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9</span></span><span
          class="roue"><span>0<br />1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9</span></span><span
          class="roue"><span>0<br />1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9</span></span>
      </div>
      <ol class="intro-phases" aria-hidden="true">
        <li>Implantation</li>
        <li>Structure</li>
        <li>Façades</li>
        <li>Matières</li>
        <li>Lumière</li>
      </ol>
      <div class="ouverture">
        <p class="ouverture-titre" aria-label="Creativ Lab Architects">CREATIV LAB</p>
        <span class="ouverture-trait" aria-hidden="true"><span></span></span>
        <p class="ouverture-sous-titre" aria-hidden="true">ARCHITECTS</p>
        <p class="ouverture-etat">Ouverture des portes <span id="chargement-pourcent">0</span> %</p>
        <button class="intro-entrer" type="button" hidden>
          <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="48" /><circle class="anneau" cx="50" cy="50" r="48" pathLength="1" /></svg>
          <span>Entrer</span>
        </button>
      </div>
    </div>
    <div class="intro-grain" aria-hidden="true"></div>
  </div>

  <div id="passage" aria-hidden="true">
    <div class="volet"></div>
    <div class="volet"></div>
    <div class="passage-texte">
      <p class="passage-etage"></p>
      <p class="passage-nom"></p>
      <span class="passage-trait"></span>
    </div>
  </div>

  <Entete avecBascule />

  <nav class="plan-etages" aria-label="Plan du bâtiment">
    {espaces.map((e, i) => (
      <button type="button" data-espace={i} data-nom={e.nom} data-etage={e.etage} aria-label={`${e.nom}, ${e.etage}`}>
        <span>{e.nom}</span>
      </button>
    ))}
  </nav>

  <div id="infobulle" aria-hidden="true"></div>

  <button id="bouton-visite" class="bouton bouton-visite" type="button">Se promener librement</button>
  <button id="bouton-auto" class="bouton bouton-auto" type="button" aria-pressed="false">▶ Visite guidée</button>
  <div id="visite" class="visite" hidden>
    <div class="visite-haut">
      <p class="visite-aide">
        <span class="aide-clavier">ZQSD ou flèches pour marcher, Maj pour courir, glissez la souris pour regarder.</span>
        <span class="aide-tactile">Joystick pour marcher, glissez l'écran pour regarder.</span>
      </p>
      <button class="bouton visite-quitter" type="button">Visite guidée</button>
    </div>
    <nav class="visite-lieux" aria-label="Aller directement à">
      <button type="button" data-lieu="parvis">Parvis</button>
      <button type="button" data-lieu="hall">Hall</button>
      <button type="button" data-lieu="galerie">Galerie</button>
      <button type="button" data-lieu="atelier">Atelier</button>
      <button type="button" data-lieu="equipe">Équipe</button>
      <button type="button" data-lieu="toit">Toit</button>
    </nav>
    <div class="visite-joystick" aria-hidden="true"><span></span></div>
  </div>

  <main class="parcours">
    <section id="accueil" class="etape accueil" data-espace="0">
      <div class="carte">
        <p class="surtitre">Creativ Lab Architects</p>
        <h1>Entrez.<br />L'architecture se visite.</h1>
        <p class="indice-scroll">Faites défiler pour entrer</p>
      </div>
    </section>

    <section id="manifeste" class="etape" data-espace="1">
      <div class="carte">
        <p class="surtitre">Le hall</p>
        <h2>Concevoir des lieux qui racontent.</h2>
        <p>
          Texte provisoire : ici, la phrase-signature du cabinet et sa vision en quelques lignes.
          Lumière, matière, usage : chaque projet part de ceux qui l'habiteront.
        </p>
      </div>
    </section>

    <section id="projets" class="etape etape--longue" data-espace="2">
      <div class="carte">
        <p class="surtitre">La galerie</p>
        <h2>Nos projets</h2>
        <p>Approchez-vous d'un cadre et cliquez pour entrer dans le projet.</p>
        <a class="bouton" href="/projets">Voir les {projets.length} projets</a>
        <ul class="grille-projets">
          {projets.map((p) => (
            <li class="carte-projet">
              <a href={`/projets/${p.slug}`}>
                <img src={p.image} alt={p.titre} loading="lazy" decoding="async" />
                <span>{p.titre}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="atelier" class="etape" data-espace="3">
      <div class="carte">
        <p class="surtitre">L'atelier, 1er étage</p>
        <h2>De l'esquisse au chantier</h2>
        <ol class="etapes-liste">
          <li>Esquisse et programme</li>
          <li>Avant-projet et images 3D</li>
          <li>Permis et dossiers techniques</li>
          <li>Suivi de chantier et livraison</li>
        </ol>
      </div>
    </section>

    <section id="services" class="etape etape--bas" data-espace="4">
      <div class="carte">
        <p class="surtitre">Nos services, 1er étage</p>
        <h2>Ce que nous faisons</h2>
        <p>De la première esquisse à la remise des clés, nos métiers défilent sur le grand écran.</p>
        <ul class="liste-services">
          {services.map((s) => (
            <li>
              <span>{s.titre}</span>
              <small>{s.resume}</small>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="equipe" class="etape etape--longue etape--bas" data-espace="5">
      <div class="carte">
        <p class="surtitre">L'équipe, 1er étage</p>
        <h2>L'équipe</h2>
        <p>Associés, architectes et techniciens : les visages derrière chaque projet.</p>
        <ul class="liste-equipe">
          {equipe.map((m) => (
            <li>
              <span>{m.nom}</span>
              <small>{m.role}</small>
            </li>
          ))}
        </ul>
        <a class="bouton" href="/equipe">Rencontrer l'équipe</a>
      </div>
    </section>

    <section id="contact" class="etape" data-espace="6">
      <button class="rouvrir-contact bouton" type="button">✉ Nous écrire</button>
      <div class="carte">
        <button class="fermer-carte" type="button" aria-label="Fermer le formulaire pour admirer la vue">✕</button>
        <p class="surtitre">La terrasse</p>
        <h2>Parlons de votre projet</h2>
        <p class="horizon">Au loin, Horizon : la tour de demain, imaginée par Creativ Lab.</p>
        <!-- Formulaire à brancher sur un service d'envoi (Formspree, Resend, etc.). -->
        <form class="formulaire" action="#" method="post">
          <label>Nom <input name="nom" autocomplete="name" required /></label>
          <label>E-mail <input name="email" type="email" autocomplete="email" required /></label>
          <label>Votre projet <textarea name="message" rows="3" required></textarea></label>
          <button class="bouton" type="submit">Envoyer</button>
        </form>
      </div>
    </section>
  </main>

  <script type="application/json" id="donnees-galerie" set:html={JSON.stringify(galerie)} />
  <script type="application/json" id="donnees-equipe" set:html={JSON.stringify(mur)} />
  <script type="application/json" id="donnees-services" set:html={JSON.stringify(services)} />

  <!-- Fiche d'un membre de l'équipe, ouverte en cliquant sur son portrait dans la scène 3D. -->
  <dialog id="fiche-membre" class="fiche-membre" aria-labelledby="fiche-nom">
    <img src="" alt="" />
    <div>
      <p class="surtitre"></p>
      <h2 id="fiche-nom"></h2>
      <p class="fiche-texte"></p>
      <a class="fiche-email" href=""></a>
      <div class="fiche-pied">
        <div class="fiche-nav">
          <button class="fiche-precedent" type="button" aria-label="Membre précédent">←</button>
          <span class="fiche-compteur"></span>
          <button class="fiche-suivant" type="button" aria-label="Membre suivant">→</button>
        </div>
        <form method="dialog">
          <button class="bouton" type="submit">Fermer</button>
        </form>
      </div>
    </div>
  </dialog>

  <script>
    import { demarrerExperience } from '../scripts/experience';

    const bascule = document.getElementById('bascule-mode');
    const simple = document.documentElement.classList.contains('mode-simple');
    if (bascule) {
      bascule.textContent = simple ? 'Version 3D' : 'Version simple';
      bascule.addEventListener('click', () => {
        try {
          localStorage.setItem('creativ-mode', simple ? '3d' : 'simple');
        } catch {}
        location.reload();
      });
    }

    if (!simple) demarrerExperience();
  </script>
</Base>
