---
import SiteSimple from '../../layouts/SiteSimple.astro';
import AutresProjets from '../../components/simple/AutresProjets.astro';
import Panorama360 from '../../components/Panorama360.astro';
import { projets, type Projet } from '../../data/projets';
import { rendusLumion } from '../../data/lumion';

export function getStaticPaths() {
  return projets.map((projet, i) => ({
    params: { slug: projet.slug },
    props: { projet, suivant: projets[(i + 1) % projets.length] },
  }));
}

interface Props {
  projet: Projet;
  suivant: Projet;
}

const { projet, suivant } = Astro.props;
const fiche = [
  ['Localisation', projet.lieu],
  ['Typologie', projet.programme],
  ['Surface', projet.surface],
  ['Date', projet.annee],
].filter(([, valeur]) => valeur);
const lumion = rendusLumion(projet.slug);
const imageHero = lumion.couverture ?? projet.image;
const i = projets.findIndex((p) => p.slug === projet.slug);
const autres = [1, 2, 3, 4, 5, 6].map((k) => projets[(i + k) % projets.length]);
// Diaporama du haut : image principale puis rendus Lumion.
const diapos = [imageHero, ...lumion.images];
---

<SiteSimple
  titre={`${projet.titre} | Creativ Lab Architects`}
  description={projet.description ?? `${projet.titre}, un projet de Creativ Lab Architects.`}
  image={imageHero}
  actif="projets"
  surImage
>
  <section class="ss-diaporama ss-diaporama--projet" aria-roledescription="carrousel" aria-label={`Images de ${projet.titre}`} data-diaporama>
    {diapos.map((src, n) => (
      <figure class:list={['ss-diapo', { 'est-active': n === 0 }]} aria-roledescription="diapositive" aria-label={`${n + 1} sur ${diapos.length}`}>
        <img src={src} alt={n === 0 ? projet.titre : `${projet.titre}, rendu ${n}`} id={n === 0 ? 'hero-image' : undefined} fetchpriority={n === 0 ? 'high' : 'low'} loading={n === 0 ? 'eager' : 'lazy'} decoding="async" />
      </figure>
    ))}
    {diapos.length > 1 && (
      <>
        <button type="button" class="ss-fleche ss-fleche--g ss-diapo-precedent" aria-label="Image précédente"></button>
        <button type="button" class="ss-fleche ss-fleche--d ss-diapo-suivant" aria-label="Image suivante"></button>
      </>
    )}
  </section>

  <section class="ss-projet">
    <h1 data-apparait>{projet.titre}</h1>
    <div class="ss-projet-texte" data-apparait>
      <p>{projet.description ?? 'Description du projet à venir : le défi, la réponse architecturale, les matériaux.'}</p>
    </div>
    {fiche.length > 0 && (
      <dl class="ss-fiche" data-apparait>
        {fiche.map(([nom, valeur]) => (
          <div>
            <dt>{nom}</dt>
            <dd>{valeur}</dd>
          </div>
        ))}
      </dl>
    )}
  </section>

  {lumion.video && (
    <section class="ss-projet-media" data-apparait>
      <video src={lumion.video} poster={lumion.affiche} controls playsinline preload="metadata"></video>
    </section>
  )}

  {lumion.panorama && (
    <section class="ss-projet-media" data-apparait>
      <Panorama360 src={lumion.panorama} titre={projet.titre} />
    </section>
  )}

  <AutresProjets projets={autres} />
</SiteSimple>

<script>
  import gsap from 'gsap';
  import { diaporama } from '../../scripts/simple';

  const voile = document.getElementById('voile');

  const diapos = document.querySelector<HTMLElement>('[data-diaporama]');
  if (diapos) diaporama(diapos, 5000);

  // On arrive du voile sombre de la galerie 3D : il se lève, le diaporama apparaît.
  const depuis3d = document.documentElement.classList.contains('mode-3d');
  if (voile && depuis3d) gsap.fromTo(voile, { opacity: 1 }, { opacity: 0, duration: 0.9, ease: 'power2.out' });
</script>
