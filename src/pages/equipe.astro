---
import SiteSimple from '../layouts/SiteSimple.astro';
import { equipe } from '../data/equipe';
---

<SiteSimple titre="L'équipe | Creativ Lab Architects" description="Les associés, architectes et techniciens de Creativ Lab Architects." actif="equipe">
  <section class="ss-section ss-entete-page">
    <h1 data-apparait>Équipe</h1>
  </section>
  <section class="ss-section ss-section--serree">
    <ul class="ss-equipe">
      {equipe.map((m) => (
        <li class="ss-membre" id={m.slug} data-apparait>
          <span class="ss-membre-photo">
            <img src={m.photo} alt={`Portrait de ${m.nom}`} loading="lazy" decoding="async" />
          </span>
          <p class="ss-membre-role">{m.role}</p>
          <h2>{m.nom}</h2>
          {m.email && <a href={`mailto:${m.email}`}>{m.email}</a>}
        </li>
      ))}
    </ul>
  </section>
</SiteSimple>
