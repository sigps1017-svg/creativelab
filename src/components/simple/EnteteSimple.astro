---
// En-tête de la version simple : logo à gauche, menu au centre, « Version 3D » à droite,
// menu plein écran sur téléphone. `surImage` : posé sur une photo (texte blanc).
interface Props {
  surImage?: boolean;
  actif?: 'projets' | 'agence' | 'equipe' | 'contact';
}
const { surImage = false, actif } = Astro.props;
const liens = [
  { id: 'projets', nom: 'Projets', href: '/projets' },
  { id: 'agence', nom: 'Agence', href: '/agence' },
  { id: 'equipe', nom: 'Équipe', href: '/equipe' },
  { id: 'contact', nom: 'Contact', href: '/contact' },
];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Raleway:wght@300;400;500&display=swap"
/>

<header class:list={['ss-entete', { 'ss-entete--image': surImage }]} data-ss-entete>
  <a class="ss-logo" href="/" aria-label="Creativ’Lab Architects, accueil">
    <span class="ss-logo-nom">CREATIV’LAB</span>
    <span class="ss-logo-sous">ARCHITECTS</span>
  </a>
  <nav class="ss-menu" id="ss-menu" aria-label="Menu principal">
    {liens.map((l) => (
      <a href={l.href} aria-current={actif === l.id ? 'page' : undefined}>{l.nom}</a>
    ))}
    <button class="ss-version3d ss-version3d--mobile" type="button" data-version-3d>Version 3D</button>
  </nav>
  <button class="ss-version3d" type="button" data-version-3d>Version 3D</button>
  <button class="ss-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="ss-menu">
    <span></span><span></span>
  </button>
</header>

<script>
  const entete = document.querySelector<HTMLElement>('[data-ss-entete]');
  const burger = entete?.querySelector<HTMLButtonElement>('.ss-burger');

  burger?.addEventListener('click', () => {
    const ouvert = burger.getAttribute('aria-expanded') !== 'true';
    burger.setAttribute('aria-expanded', String(ouvert));
    entete!.classList.toggle('ss-entete--ouvert', ouvert);
    document.documentElement.classList.toggle('ss-sans-defilement', ouvert);
  });

  // Retour à la visite 3D : choix mémorisé, puis accueil.
  document.querySelectorAll('[data-version-3d]').forEach((b) =>
    b.addEventListener('click', () => {
      try {
        localStorage.setItem('creativ-mode', '3d');
      } catch {}
      location.href = '/';
    }),
  );
</script>
