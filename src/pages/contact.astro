---
import SiteSimple from '../layouts/SiteSimple.astro';
import { cabinet } from '../data/cabinet';

const rubriques = [
  cabinet.emailRecrutement && { titre: 'Recrutement', lignes: [cabinet.emailRecrutement], href: `mailto:${cabinet.emailRecrutement}` },
  cabinet.email && { titre: cabinet.emailRecrutement ? 'Tout autre sujet' : 'E-mail', lignes: [cabinet.email], href: `mailto:${cabinet.email}` },
  cabinet.telephone && { titre: 'Téléphone', lignes: [cabinet.telephone], href: `tel:${cabinet.telephone.replace(/[^+\d]/g, '')}` },
  { titre: 'Adresse', lignes: cabinet.adresse, href: cabinet.carte },
].filter((r) => !!r) as { titre: string; lignes: string[]; href: string }[];
const carte = `https://www.google.com/maps?q=${encodeURIComponent(cabinet.adresse.join(', '))}&output=embed`;
---

<SiteSimple titre="Contact | Creativ Lab Architects" description="Contacter Creativ Lab Architects, cabinet d'architecture à Abidjan." actif="contact">
  <section class="ss-contact">
    <div class="ss-contact-texte">
      <h1>Contact</h1>
      <dl class="ss-coordonnees">
        {rubriques.map((r) => (
          <div>
            <dt>{r.titre} :</dt>
            <dd>
              <a href={r.href} target={r.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                {r.lignes.map((l) => <span>{l}</span>)}
              </a>
            </dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="ss-contact-carte">
      <iframe src={carte} title="Plan d'accès" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</SiteSimple>
