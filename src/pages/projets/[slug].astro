---
import SiteSimple from '../../layouts/SiteSimple.astro';
import CarteProjet from '../../components/simple/CarteProjet.astro';
import Panorama360 from '../../components/Panorama360.astro';
import { projets, type Projet } from '../../data/projets';
import { rendusLumion } from '../../data/lumion';

export function getStaticPaths() {
  return projets.map((projet, i) => ({
    params: { slug: projet.slug },
    props: { projet, suivant: projets[(i + 1) % projets.length] },
  }));
}

interface Props {
  projet: Projet;
  suivant: Projet;
}

const { projet, suivant } = Astro.props;
const fiche = [
  ['Localisation', projet.lieu],
  ['Typologie', projet.programme],
  ['Surface', projet.surface],
  ['Date', projet.annee],
].filter(([, valeur]) => valeur);
const lumion = rendusLumion(projet.slug);
const imageHero = lumion.couverture ?? projet.image;
const i = projets.findIndex((p) => p.slug === projet.slug);
const autres = [1, 2, 3, 4, 5].map((k) => projets[(i + k) % projets.length]);
---

<SiteSimple
  titre={`${projet.titre} | Creativ Lab Architects`}
  description={projet.description ?? `${projet.titre}, un projet de Creativ Lab Architects.`}
  image={imageHero}
  actif="projets"
>
  <section class="ss-projet-hero">
    <img src={imageHero} alt={projet.titre} id="hero-image" fetchpriority="high" />
  </section>

  <section class="ss-section ss-projet-tete">
    <h1 data-apparait>{projet.titre}</h1>
    {fiche.length > 0 && (
      <dl class="ss-fiche" data-apparait>
        {fiche.map(([nom, valeur]) => (
          <div>
            <dt>{nom}</dt>
            <dd>{valeur}</dd>
          </div>
        ))}
      </dl>
    )}
    <div class="ss-projet-texte" data-apparait>
      <p>{projet.description ?? 'Description du projet à venir : le défi, la réponse architecturale, les matériaux.'}</p>
    </div>
  </section>

  {lumion.video && (
    <section class="ss-projet-media" data-apparait>
      <video src={lumion.video} poster={lumion.affiche} controls playsinline preload="metadata"></video>
    </section>
  )}

  {lumion.images.length > 0 && (
    <section class="ss-projet-galerie" aria-label="Rendus du projet">
      {lumion.images.map((src, n) => (
        <button type="button" class="vignette" data-image={src} aria-label={`Agrandir le rendu ${n + 1}`} data-apparait>
          <img src={src} alt={`${projet.titre}, rendu ${n + 1}`} loading="lazy" decoding="async" />
        </button>
      ))}
    </section>
  )}

  {lumion.panorama && (
    <section class="ss-projet-media" data-apparait>
      <Panorama360 src={lumion.panorama} titre={projet.titre} />
    </section>
  )}

  <section class="ss-section">
    <div class="ss-titre-section" data-apparait>
      <h2>Autres projets</h2>
      <a class="ss-lien-fleche" href={`/projets/${suivant.slug}`}>Projet suivant</a>
    </div>
    <ul class="ss-grille ss-grille--5">
      {autres.map((p) => <CarteProjet projet={p} format="portrait" />)}
    </ul>
  </section>

  <dialog class="visionneuse" aria-label="Rendu agrandi" slot="apres">
    <img alt="" />
    <button type="button" class="fermer" aria-label="Fermer">✕</button>
  </dialog>
</SiteSimple>

<script>
  import gsap from 'gsap';

  const voile = document.getElementById('voile');
  const image = document.getElementById('hero-image');
  const animer = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Galerie : un rendu touché s'ouvre en grand, on ferme d'un toucher.
  const visionneuse = document.querySelector<HTMLDialogElement>('.visionneuse');
  const grande = visionneuse?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('.vignette').forEach((vignette) =>
    vignette.addEventListener('click', () => {
      if (!visionneuse || !grande) return;
      grande.src = vignette.dataset.image!;
      grande.alt = vignette.querySelector('img')?.alt ?? '';
      visionneuse.showModal();
    }),
  );
  visionneuse?.addEventListener('click', () => visionneuse.close());

  // On arrive du voile sombre de la galerie 3D : il se lève, l'image se dévoile en reculant légèrement.
  const depuis3d = document.documentElement.classList.contains('mode-3d');
  if (voile && depuis3d) gsap.fromTo(voile, { opacity: 1 }, { opacity: 0, duration: 0.9, ease: 'power2.out' });
  if (image && animer) {
    gsap.from(image, { scale: 1.12, duration: 2.2, ease: 'power3.out' });
    addEventListener('scroll', () => gsap.set(image, { y: scrollY * 0.3 }), { passive: true });
  }
</script>
