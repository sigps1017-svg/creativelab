---
// Accueil de la version simple : diaporama plein écran des projets à la une, puis autres projets.
import { projets } from '../../data/projets';
import { projetsUne, agence } from '../../data/cabinet';
import CarteProjet from './CarteProjet.astro';

const une = projetsUne.map((slug) => projets.find((p) => p.slug === slug)).filter((p) => p !== undefined);
const autres = projets.filter((p) => !projetsUne.includes(p.slug)).slice(0, 6);
const total = String(une.length).padStart(2, '0');
---

<h1 class="ss-masque">Creativ’Lab Architects, cabinet d’architecture à Abidjan</h1>

<section class="ss-diaporama" aria-roledescription="carrousel" aria-label="Projets à la une" data-diaporama>
  {une.map((p, i) => (
    <article class:list={['ss-diapo', { 'est-active': i === 0 }]} aria-roledescription="diapositive" aria-label={`${i + 1} sur ${une.length}`}>
      <img src={p.image} alt="" fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
      <a class="ss-diapo-texte" href={`/projets/${p.slug}`}>
        <h2>{p.titre}</h2>
        <p>{[p.lieu, p.annee].filter(Boolean).join(' · ') || 'Voir le projet'}</p>
      </a>
    </article>
  ))}
  <div class="ss-diapo-commandes">
    <p class="ss-diapo-compteur"><span class="ss-diapo-numero">01</span> / {total}</p>
    <div class="ss-diapo-barres">
      {une.map((p, i) => (
        <button type="button" class="ss-diapo-barre" aria-label={`Afficher ${p.titre}`}><span></span></button>
      ))}
    </div>
  </div>
  <button type="button" class="ss-diapo-precedent" aria-label="Projet précédent"></button>
  <button type="button" class="ss-diapo-suivant" aria-label="Projet suivant"></button>
  <a class="ss-defiler" href="#ss-suite" aria-label="Voir la suite"></a>
</section>

<section class="ss-section ss-intro" id="ss-suite">
  <p class="ss-intro-texte" data-apparait>{agence.vision}</p>
  <a class="ss-lien-fleche" href="/agence" data-apparait>Découvrir l’agence</a>
</section>

<section class="ss-section">
  <div class="ss-titre-section" data-apparait>
    <h2>Autres projets</h2>
    <a class="ss-lien-fleche" href="/projets">Tous les projets</a>
  </div>
  <ul class="ss-grille">
    {autres.map((p) => <CarteProjet projet={p} />)}
  </ul>
</section>
