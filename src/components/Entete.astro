---
import { morceaux } from '../data/musique';

interface Props {
  avecBascule?: boolean;
}
const { avecBascule = false } = Astro.props;
---

<header class="entete">
  <a class="logo" href="/">Creativ Lab <span>Architects</span></a>
  <nav class="menu" aria-label="Menu principal">
    <a href="/#projets">Projets</a>
    <a href="/#atelier">Savoir-faire</a>
    <a href="/#equipe">Équipe</a>
    <a href="/#contact">Contact</a>
    <div class="musique">
      <button
        class="bouton musique-bouton"
        type="button"
        aria-label="Musique"
        aria-expanded="false"
        aria-controls="musique-menu"
      >
        <span class="musique-barres" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </button>
      <div class="musique-menu" id="musique-menu" hidden>
        <p class="musique-titre">Musique</p>
        <button class="musique-son" type="button">▶ Écouter</button>
        <ul>
          {morceaux.map((m, i) => (
            <li>
              <button type="button" data-morceau={i} aria-pressed="false">
                {m.titre}
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
    {avecBascule && (
      <button class="bouton bouton-lumiere" type="button" id="bascule-lumiere" hidden>☀ Auto</button>
    )}
    {avecBascule && (
      <button class="bouton" type="button" id="bascule-mode">Version simple</button>
    )}
  </nav>
</header>

<script>
  import '../scripts/musique';
</script>
